{
  "name": "aislenote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "kill-port 5173 && vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run src/state/vault.test.ts src/state/default-app-state.test.ts src/theme/vault-themes.test.ts src/filters/sidebar-search.test.ts src/app/vault-editor-persistence.test.ts src/app/VaultApp-source.test.ts src/storage/usePersistentAppState-source.test.ts src/storage/local-preferences.test.ts src/editor/useVaultAisleEditors-source.test.ts electron/storage-watcher.test.mjs electron/vault-library.test.mjs electron/ipc-storage.test.mjs electron/app-state-storage.schema2.test.mjs",
    "preview": "vite preview",
    "electron": "node scripts/start-electron.mjs",
    "electron:mac": "node scripts/start-electron.mjs",
    "electron:windows": "node scripts/start-electron.mjs",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && node scripts/start-electron.mjs --dev\"",
    "electron:dev:mac": "npm run electron:dev",
    "electron:dev:windows": "npm run electron:dev",
    "electron:build": "npm run build:electron",
    "build:electron": "npm run build && npm run electron",
    "build:electron:mac": "npm run build && npm run electron:mac",
    "build:electron:windows": "npm run build && npm run electron:windows",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "package:linux": "npm run build && electron-builder --linux --x64",
    "start:mac": "npm run build:electron:mac",
    "start:windows": "npm run build:electron:windows",
    "dev:electron": "npm run electron:dev",
    "dev:electron:mac": "npm run electron:dev:mac",
    "dev:electron:windows": "npm run electron:dev:windows",
    "editor:benchmark": "node scripts/run-editor-benchmark.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "build": {
    "productName": "AisleNote",
    "appId": "com.josephgeorge.aislenote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.mjs",
      "electron/preload.cjs",
      "build/icon.png",
      "src/markdown/*.js",
      "src/storage/*.js",
      "src/settings/*.js",
      "src/state/*.js",
      "src/tags/*.js",
      "package.json",
      "!**/*.test.*"
    ],
    "mac": {
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icons"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/share": "^8.0.1",
    "@toast-ui/editor": "^3.2.2",
    "bootstrap": "^5.3.8",
    "jszip": "^3.10.1",
    "prosemirror-transform": "^1.12.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^38.7.1",
    "electron-builder": "^26.15.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "kill-port": "^2.0.1",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.3"
  }
}
