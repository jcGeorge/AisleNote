{
  "name": "tabs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "kill-port 5173 && vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "electron": "node scripts/start-electron.mjs",
    "electron:mac": "node scripts/start-electron.mjs",
    "electron:windows": "node scripts/start-electron.mjs",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && node scripts/start-electron.mjs --dev\"",
    "electron:dev:mac": "npm run electron:dev",
    "electron:dev:windows": "npm run electron:dev",
    "electron:build": "npm run build:electron",
    "build:electron": "npm run build && npm run electron",
    "build:electron:mac": "npm run build && npm run electron:mac",
    "build:electron:windows": "npm run build && npm run electron:windows",
    "start:mac": "npm run build:electron:mac",
    "start:windows": "npm run build:electron:windows",
    "dev:electron": "npm run electron:dev",
    "dev:electron:mac": "npm run electron:dev:mac",
    "dev:electron:windows": "npm run electron:dev:windows"
  },
  "dependencies": {
    "@toast-ui/editor": "^3.2.2",
    "bootstrap": "^5.3.8",
    "jszip": "^3.10.1",
    "prosemirror-transform": "^1.12.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^38.7.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "kill-port": "^2.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.3"
  }
}
